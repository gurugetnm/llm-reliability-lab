# =============================================================================
# LLM Reliability Lab — environment configuration
#
# Copy this file to `.env` and adjust as needed:
#   cp .env.example .env
#
# `.env` is read by both `docker-compose.yml` and, for local (non-Docker)
# development, by apps/api (via pydantic-settings) and apps/web (via
# Next.js's built-in .env loading). Never commit a real `.env` file.
# =============================================================================

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ---
# Used by docker-compose to configure the Postgres container.
POSTGRES_USER=llm_lab
POSTGRES_PASSWORD=llm_lab
POSTGRES_DB=llm_reliability_lab
POSTGRES_PORT=5432

# Full connection string used by the API (async, SQLAlchemy + asyncpg).
# When running the API via Docker Compose, host "db" resolves to the
# postgres service; when running the API locally, use "localhost".
DATABASE_URL=postgresql+asyncpg://llm_lab:llm_lab@localhost:5432/llm_reliability_lab

# --- CORS ---
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --- LLM providers ---
# Base URL of a local Ollama instance, used when running the API natively
# (not via Docker Compose — see docker-compose.yml's OLLAMA_BASE_URL_DOCKER
# for the containerized default, which is already host.docker.internal and
# usually doesn't need overriding here).
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434
DEFAULT_MODEL=llama3.1

# --- Frontend ---
# Base URL the Next.js app uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:8000
